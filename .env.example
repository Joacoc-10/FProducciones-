# Clave pública de Web3Forms (https://web3forms.com). El destinatario de los pedidos se
# configura en la cuenta de Web3Forms asociada a esta clave. Restringila por dominio.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# URL pública definitiva del sitio (canonical, sitemap, Open Graph). Opcional.
# NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com.uy

# SITE_NOINDEX=1 fuerza noindex y bloquea robots.txt (útil en entornos de prueba fuera de Vercel).
# En Vercel, solo VERCEL_ENV=production se indexa; los previews salen con noindex automáticamente.
