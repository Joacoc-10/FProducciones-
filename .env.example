# EmailJS (https://www.emailjs.com): envío del formulario de presupuesto desde el navegador.
# Las tres son públicas por diseño (se incluyen en el bundle). NO cargar acá claves privadas ni
# credenciales de correo. El destinatario, el asunto y el Reply-To se definen en la plantilla de
# EmailJS. Restringí los orígenes permitidos en la cuenta. Guía: docs/EMAILJS.md
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# URL pública definitiva del sitio (canonical, sitemap, Open Graph). Opcional.
# NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com.uy

# SITE_NOINDEX=1 fuerza noindex y bloquea robots.txt (útil en entornos de prueba fuera de Vercel).
# En Vercel, solo VERCEL_ENV=production se indexa; los previews salen con noindex automáticamente.
